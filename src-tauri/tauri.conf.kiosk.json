{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LE.GO.LAS Kiosk",
  "version": "0.1.0",
  "identifier": "uz.legolas.kiosk",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:3000/panel",
    "beforeBuildCommand": "",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "kiosk",
        "title": "LE.GO.LAS — Переговорная",
        "url": "http://localhost:3000/panel",
        "fullscreen": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "focus": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": null,
      "timestampUrl": null
    },
    "macOS": {
      "signingIdentity": null
    }
  }
}
